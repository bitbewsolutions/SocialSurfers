# Cache policy. Understood by Cloudflare Pages, Cloudflare Workers Static Assets and
# Netlify alike, so it survives a change of host.
#
# The rule is: anything with a content hash in its filename can be cached forever,
# because a new build produces a new filename. Anything without one gets revalidated.

# Astro emits /_astro/*.[hash].{js,css} — the hash IS the cache key
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are hard-subset and effectively frozen; a change would ship a new filename.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Client logo tiles are regenerated only when the roster changes.
/clients/*
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000

# HTML must revalidate or a deploy would not reach anyone still holding a copy.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
