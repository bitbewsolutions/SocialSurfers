---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Proof from '../components/Proof.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Base
  title={`${site.name} — ${site.category}`}
  description="Social media management, content, video, performance marketing and websites. We don't just manage — we grow brands."
  isHome
>
  <Nav />
  <main id="main">
    <Hero />
    <Stats />
    <About />
    <Services />
    <Process />
    <Proof />
    <Contact />
  </main>
  <Footer />
</Base>

<script>
  import { initScroll, initReveals, initSectionProgress, initCounters } from '../scripts/scroll';
  import { initMarquee } from '../scripts/marquee';
  initScroll();
  initReveals();
  initSectionProgress();
  initCounters();
  initMarquee();
</script>
