---
import { process } from '../data/content';

/* Serpentine tide chart, generated at build time so node coordinates and grid rows
   can never drift apart. Each Q segment peaks at x = 135 / 65 (at t=0.5), which is
   exactly where the step nodes sit. */
const SEG = 160;
const CX = 100;
const VB_W = 200;
const H = process.length * SEG;

const nodes = process.map((_, i) => ({
  xPct: ((i % 2 === 0 ? 135 : 65) / VB_W) * 100,
  yPct: ((80 + i * SEG) / H) * 100,
}));

let d = `M${CX} 0`;
process.forEach((_, i) => {
  const ctrlX = i % 2 === 0 ? 170 : 30;
  d += ` Q${ctrlX} ${i * SEG + 80} ${CX} ${(i + 1) * SEG}`;
});
---

<section class="process tone-dark from-light" id="process">
  <div class="shell head">
    <p class="label" data-reveal>How we work</p>
    <h2 class="h2" data-reveal>The same seven steps,<br /><em>every single month.</em></h2>
    <p class="lead" data-reveal>
      You always know what we&rsquo;re doing, when we&rsquo;re doing it, and what you get at
      the end of the month.
    </p>
  </div>

  <div class="shell">
    {/* --p is measured on the CHART, not the whole section, and anchored to 62% of the
        viewport. Measuring the section meant the tall heading block ate most of the
        range and the line ran ~40% behind the reader. Anchored this way, the drawn tip
        sits at the same screen height the whole way down — it enters with the chart and
        stays on screen until the chart leaves. */}
    <div class="chart" style={`--steps:${process.length}`} data-progress data-progress-anchor="0.62">
      <div class="tide" aria-hidden="true">
        <svg class="lay" viewBox={`0 0 ${VB_W} ${H}`} preserveAspectRatio="none">
          <path class="track" d={d} />
        </svg>

        {/* The drawn line is a full-length path revealed by a vertical clip, NOT a
            stroke-dasharray.

            The dash version was wrong twice over. `preserveAspectRatio="none"` stretches
            this viewBox ~3x horizontally, and `vector-effect: non-scaling-stroke` makes
            the browser measure dashes against the STRETCHED path while `pathLength="1"`
            normalises against the unstretched one. The two lengths disagree, so the
            gap ran out before the path did and a phantom second stroke appeared near
            the bottom around step 5 — and the dash never covered the full line either.

            A clip has no length arithmetic in it at all: progress is vertical position,
            which is also exactly what "follows the scroll" should mean. */}
        {/* pins live in HTML, not the SVG: preserveAspectRatio="none" stretches the
            viewBox ~3x horizontally, which would squash any <circle> into an ellipse.
            Unlit pins go first so the lit layer paints over them. */}
        {nodes.map((n) => (
          <span class="pin" style={`--x:${n.xPct}%;--y:${n.yPct}%`}></span>
        ))}

        <div class="wet">
          <svg class="lay" viewBox={`0 0 ${VB_W} ${H}`} preserveAspectRatio="none">
            <defs>
              {/* the same ramp as --grad; coral is too pale to read as a line on paper */}
              <linearGradient id="tideGrad" x1="0" y1="0" x2="0" y2="1">
                {/* tokens, not literals: .tone-dark rebinds --violet/--rose to values
                    that stay legible on ink, and this line inherits that for free */}
                <stop offset="0" stop-color="var(--violet)" />
                <stop offset="1" stop-color="var(--rose)" />
              </linearGradient>
            </defs>
            <path class="live" d={d} />
          </svg>

          {/* lit pins ride inside the same clip, so a node lights the instant the
              line reaches it — no second progress calculation to drift out of sync */}
          {nodes.map((n) => (
            <span class="pin lit" style={`--x:${n.xPct}%;--y:${n.yPct}%`}></span>
          ))}
        </div>
      </div>

      <ol class="steps">
        {process.map((s, i) => (
          <li
            class="step"
            style={`--row:${i + 1}`}
            data-side={i % 2 === 0 ? 'left' : 'right'}
            data-reveal
            data-reveal-group="proc"
          >
            <span class="n">{String(s.n).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  /* One ground. The old version was two pinned bands ramping golden-hour into dusk,
     which is exactly the arc that has been removed — and it was also the section
     that first exposed the percentage-gradient contrast bug. Flat paper cannot
     drift, so that whole class of failure is gone with it. */
  /* .tone-dark (global.css) carries the ground, the ramp in from the light half of
     the page, and the token flip that lets the rules below stay ground-agnostic. */
  .process {
    position: relative;
    overflow: hidden;
    padding-bottom: var(--section-y);
  }

  .head { display: grid; gap: 20px; }
  .head .label { color: var(--l3); }
  .head .h2 { color: var(--l1); max-width: 20ch; }
  .head .lead { color: var(--l2); }

  .chart {
    position: relative;
    margin-top: clamp(56px, 9vh, 110px);
    --step-h: clamp(160px, 19vh, 200px);
  }

  .tide {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: min(58%, 640px);
    height: calc(var(--steps) * var(--step-h));
    pointer-events: none;
  }
  .tide .lay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .tide .track {
    fill: none;
    stroke: var(--hair);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  /* Drawn by scroll position via a vertical clip, not a stroke-dasharray.
     preserveAspectRatio="none" stretches this viewBox ~3x horizontally, and
     vector-effect makes the browser measure dashes against the STRETCHED path while
     pathLength normalises against the unstretched one — the two disagree, so the gap
     ran out before the path did and a phantom second stroke appeared near step 5.
     A clip has no length arithmetic in it at all. */
  .wet {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 calc(100% - var(--p, 0) * 100%) 0);
  }
  .tide .live {
    fill: none;
    stroke: url(#tideGrad);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
  }

  .pin {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--hair-2);
  }
  .pin.lit {
    border-color: var(--rose);
    background: #fff;
    box-shadow: 0 0 0 4px rgba(196, 27, 110, 0.12);
  }

  .steps {
    position: relative;
    display: grid;
    grid-auto-rows: var(--step-h);
  }
  .step {
    grid-row: var(--row);
    grid-column: 1;
    max-width: 34ch;
    align-self: center;
  }
  .step[data-side='left'] { justify-self: start; }
  .step[data-side='right'] { justify-self: end; text-align: right; }

  .n {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--rose);
    display: block;
    margin-bottom: 10px;
  }
  .step h3 {
    font-family: var(--display);
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.022em;
    color: var(--l1);
  }
  .step p {
    margin-top: 9px;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--l2);
  }

  @media (max-width: 900px) {
    .chart { --step-h: auto; }
    .tide { display: none; }
    .steps {
      grid-auto-rows: auto;
      gap: 32px;
      border-left: 1px solid var(--hair);
      padding-left: 24px;
    }
    /* the same --p drives a filling rail, so the phone gets the effect too —
       it just runs down a straight line instead of a serpentine */
    .steps::after {
      content: '';
      position: absolute;
      left: -1px;
      top: 0;
      width: 2px;
      height: 100%;
      background: linear-gradient(180deg, var(--violet), var(--rose));
      transform: scaleY(var(--p, 0));
      transform-origin: top;
    }
    .step,
    .step[data-side='right'] {
      max-width: none;
      justify-self: stretch;
      text-align: left;
      position: relative;
    }
    .step::before {
      content: '';
      position: absolute;
      left: -29px;
      top: 4px;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--paper);
      border: 2px solid var(--rose);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* nothing to scrub against — show the finished chart */
    .wet { clip-path: none; }
    .steps::after { transform: none; }
  }
</style>
