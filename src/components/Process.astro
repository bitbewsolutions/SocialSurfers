---
import { process } from '../data/content';

/* Serpentine tide chart, generated at build time so node coordinates and grid rows
   can never drift apart. Each Q segment peaks at x = 135 / 65 (at t=0.5), which is
   exactly where the step nodes sit. */
const SEG = 160;
const CX = 100;
const VB_W = 200;
const H = process.length * SEG;

const nodes = process.map((_, i) => ({
  xPct: ((i % 2 === 0 ? 135 : 65) / VB_W) * 100,
  yPct: ((80 + i * SEG) / H) * 100,
}));

let d = `M${CX} 0`;
process.forEach((_, i) => {
  const ctrlX = i % 2 === 0 ? 170 : 30;
  d += ` Q${ctrlX} ${i * SEG + 80} ${CX} ${(i + 1) * SEG}`;
});
---

<section class="process" id="process">
  {/* Two background bands rather than one section-wide gradient. A percentage-based
      gradient shifts with section height, so on mobile (where the steps stack and the
      section is ~2x taller) the first steps landed on the light half — white-on-pink,
      well under AA. Banding pins the handover to the head/chart boundary. */}
  <div class="upper">
    <div class="shell head">
      <p class="label" data-reveal>How we work</p>
      <h2 class="h2" data-reveal>The same seven steps,<br />every single month.</h2>
      <p class="lead" data-reveal>
        You always know what we&rsquo;re doing, when we&rsquo;re doing it, and what you get at
        the end of the month.
      </p>
    </div>
  </div>

  <div class="lower shell">
    {/* --p is measured on the CHART, not the whole section, and anchored to 62% of the
        viewport. Measuring the section meant the tall heading block ate most of the
        range and the line ran ~40% behind the reader. Anchored this way, the drawn tip
        sits at the same screen height the whole way down — it enters with the chart and
        stays on screen until the chart leaves. */}
    <div class="chart" style={`--steps:${process.length}`} data-progress data-progress-anchor="0.62">
      <div class="tide" aria-hidden="true">
        <svg class="lay" viewBox={`0 0 ${VB_W} ${H}`} preserveAspectRatio="none">
          <path class="track" d={d} />
        </svg>

        {/* The drawn line is a full-length path revealed by a vertical clip, NOT a
            stroke-dasharray.

            The dash version was wrong twice over. `preserveAspectRatio="none"` stretches
            this viewBox ~3x horizontally, and `vector-effect: non-scaling-stroke` makes
            the browser measure dashes against the STRETCHED path while `pathLength="1"`
            normalises against the unstretched one. The two lengths disagree, so the
            gap ran out before the path did and a phantom second stroke appeared near
            the bottom around step 5 — and the dash never covered the full line either.

            A clip has no length arithmetic in it at all: progress is vertical position,
            which is also exactly what "follows the scroll" should mean. */}
        {/* pins live in HTML, not the SVG: preserveAspectRatio="none" stretches the
            viewBox ~3x horizontally, which would squash any <circle> into an ellipse.
            Unlit pins go first so the lit layer paints over them. */}
        {nodes.map((n) => (
          <span class="pin" style={`--x:${n.xPct}%;--y:${n.yPct}%`}></span>
        ))}

        <div class="wet">
          <svg class="lay" viewBox={`0 0 ${VB_W} ${H}`} preserveAspectRatio="none">
            <defs>
              <linearGradient id="tideGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#FF6A4D" />
                <stop offset=".4" stop-color="#FF4E8E" />
                <stop offset="1" stop-color="#EA1C82" />
              </linearGradient>
            </defs>
            <path class="live" d={d} />
          </svg>

          {/* lit pins ride inside the same clip, so a node lights the instant the
              line reaches it — no second progress calculation to drift out of sync */}
          {nodes.map((n) => (
            <span class="pin lit" style={`--x:${n.xPct}%;--y:${n.yPct}%`}></span>
          ))}
        </div>
      </div>

      <ol class="steps">
        {process.map((s, i) => (
          <li
            class="step"
            style={`--row:${i + 1}`}
            data-side={i % 2 === 0 ? 'left' : 'right'}
            data-reveal
            data-reveal-group="proc"
          >
            <span class="n">{String(s.n).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  /* Golden hour resolving to dusk, in two pinned bands. */
  .process {
    position: relative;
    color: var(--t1);
    overflow: hidden;
    background: #2a1240;
  }

  .upper {
    padding-block: var(--section-y) clamp(56px, 8vh, 100px);
    background: linear-gradient(180deg, var(--foam) 0%, #f5e3d4 42%, #e0b3ac 78%, #c07f8c 100%);
  }

  /* fixed-pixel stops: the handover always completes in the same distance,
     whatever the section ends up being */
  .lower {
    padding-top: 150px;
    padding-bottom: var(--section-y);
    background:
      linear-gradient(180deg, #c07f8c 0px, #8a4470 50px, #3d1a52 105px, #2a1240 148px)
      no-repeat;
    background-color: #2a1240;
  }

  .head { display: grid; gap: 20px; }
  .head .label { color: var(--l3); }
  .head .h2 { color: var(--l1); max-width: 20ch; }
  .head .lead { color: var(--l2); }

  .chart {
    position: relative;
    --step-h: clamp(160px, 19vh, 200px);
  }

  .tide {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: min(58%, 640px);
    height: calc(var(--steps) * var(--step-h));
    pointer-events: none;
  }
  .tide .lay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .tide .track {
    fill: none;
    stroke: rgba(250, 247, 251, 0.14);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  /* drawn by scroll position, not by a pinned scrub — see initSectionProgress() */
  .wet {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 calc(100% - var(--p, 0) * 100%) 0);
  }
  .tide .live {
    fill: none;
    stroke: url(#tideGrad);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    filter: drop-shadow(0 0 7px rgba(234, 28, 130, 0.55));
  }

  .pin {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    border-radius: 50%;
    background: #2a1240;
    border: 2px solid rgba(250, 247, 251, 0.22);
  }
  .pin.lit {
    border-color: var(--bio);
    background: #3a0f2c;
    box-shadow: 0 0 14px rgba(234, 28, 130, 0.75);
  }

  .steps {
    position: relative;
    display: grid;
    grid-auto-rows: var(--step-h);
  }
  .step {
    grid-row: var(--row);
    grid-column: 1;
    max-width: 34ch;
    align-self: center;
  }
  .step[data-side='left'] { justify-self: start; }
  .step[data-side='right'] { justify-self: end; text-align: right; }

  .n {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--coral);
    display: block;
    margin-bottom: 10px;
  }
  .step h3 {
    font-family: var(--display);
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.022em;
  }
  .step p {
    margin-top: 9px;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--t2);
  }

  @media (max-width: 900px) {
    .chart { --step-h: auto; }
    .tide { display: none; }
    .steps {
      grid-auto-rows: auto;
      gap: 32px;
      border-left: 1px solid rgba(250, 247, 251, 0.18);
      padding-left: 24px;
    }
    /* the same --p drives a filling rail, so the phone gets the effect too —
       it just runs down a straight line instead of a serpentine */
    .steps::after {
      content: '';
      position: absolute;
      left: -1px;
      top: 0;
      width: 2px;
      height: 100%;
      background: linear-gradient(180deg, var(--coral), var(--bio-lift) 42%, var(--bio));
      box-shadow: 0 0 9px rgba(234, 28, 130, 0.55);
      transform: scaleY(var(--p, 0));
      transform-origin: top;
    }
    .step,
    .step[data-side='right'] {
      max-width: none;
      justify-self: stretch;
      text-align: left;
      position: relative;
    }
    .step::before {
      content: '';
      position: absolute;
      left: -29px;
      top: 4px;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #2a1240;
      border: 2px solid var(--bio);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* nothing to scrub against — show the finished chart */
    .wet { clip-path: none; }
    .steps::after { transform: none; }
  }
</style>
