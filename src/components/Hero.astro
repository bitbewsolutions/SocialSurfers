---
import { waLink } from '../data/site';
import art from '../data/hero-art.json';

/* Light ground, one dense focal element, type on the left.
   The focal element is now the client's own render, knocked out of its white
   ground by tools/hero.mjs so it sits ON the paper rather than in a pale box.

   It is treated as a monogram, not as a picture: the silhouette is an S, and so
   is the board, and so is the wetsuit. That is why it gets no frame, no card and
   no drop shadow — a container would turn the brand's own letterform back into
   stock art. The placeholder metric/post/reel cards it replaces are in git at
   fa956c3^ if the artwork ever has to come down (see the brand-marks note in
   README) and the shader below has to carry the hero again. */

const srcset = art.sources.map((s) => `${s.src} ${s.w}w`).join(', ');
---

<section class="hero" data-hero>
  {/* ——— PREVIOUS HERO: the WebGL current ———————————————————————————————
      Commented rather than deleted: this is the fallback if the client's render
      has to be withdrawn over the Meta/YouTube/TikTok marks. src/scripts/fluid.ts
      is untouched on disk, and with the import below commented out it is no
      longer bundled at all — the shader costs nothing while it is parked.

      It is off because the render's ground is knocked out to transparency now, so
      the artwork would sit directly on a live, saturated, moving gradient. The 3D
      icons and the shader compete for the same attention at the same size, and
      the surfer loses. To restore: uncomment these two elements, the .fallback /
      .current block in the stylesheet, and the script at the foot of this file.

  <div class="fallback" aria-hidden="true"></div>
  <canvas class="current" data-fluid aria-hidden="true"></canvas>
  ————————————————————————————————————————————————————————————————————— */}

  <div class="shell inner">
    <div class="copy">
      <p class="eyebrow" data-reveal>Strategy. Creativity. Technology. Results.</p>

      {/* the client's own tagline. "Social Waves" carries the gradient — one of
          exactly two gradient fills on the site. */}
      <h1 data-reveal>
        Let&rsquo;s Surf Your Brand to the <em>Social Waves.</em>
      </h1>

      <p class="sub" data-reveal>
        We plan it, create the content, run the ads and send you a clear report every
        month. One team for all of it.
      </p>

      <div class="ctas" data-reveal>
        <a class="btn" href="#enquire">
          Book a discovery call
          <svg class="arw" width="15" height="10" viewBox="0 0 15 10" fill="none" aria-hidden="true">
            <path d="M0 5h13M9 1l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a class="btn-ghost" href={waLink()} target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.16c-.24.68-1.2 1.26-1.97 1.42-.53.11-1.21.2-3.51-.75-2.95-1.22-4.84-4.21-4.99-4.4-.14-.2-1.19-1.58-1.19-3.02s.76-2.14 1.03-2.43c.27-.29.58-.37.78-.37.19 0 .39 0 .56.01.18.01.42-.07.66.5.24.58.82 2.01.89 2.16.07.14.12.31.02.51-.1.19-.15.31-.29.48-.15.17-.31.38-.44.51-.15.14-.3.3-.13.59.17.29.76 1.25 1.63 2.02 1.12.99 2.06 1.3 2.35 1.45.29.14.46.12.63-.07.17-.2.73-.85.92-1.14.19-.29.39-.24.65-.15.27.1 1.69.8 1.98.94.29.15.48.22.55.34.07.12.07.7-.17 1.39z" />
          </svg>
          WhatsApp us
        </a>
      </div>
    </div>

    {/* Three nested elements because three independent motions have to compose on
        one image, and they cannot share a transform: the swell runs once, the ride
        loops forever, the descent is bound to scroll position. */}
    <div class="art">
      <span class="bloom" aria-hidden="true"></span>
      <div class="swell">
        <div class="drift">
          <img
            class="ride"
            src={art.src}
            srcset={srcset}
            sizes="(max-width: 900px) 58vw, 480px"
            width={art.width}
            height={art.height}
            alt=""
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 132px 0 92px;
    overflow: hidden;
    background: var(--paper);
  }

  /* ——— PREVIOUS HERO: the WebGL current ———————————————————————————————
     Parked with the markup above. See the note there before restoring.

  .fallback {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(58% 62% at 78% 44%, rgba(196, 27, 110, 0.5), transparent 68%),
      radial-gradient(46% 54% at 92% 74%, rgba(255, 106, 77, 0.34), transparent 66%),
      radial-gradient(52% 60% at 62% 22%, rgba(74, 27, 114, 0.42), transparent 70%);
    filter: blur(6px);
  }
  .current {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.1s ease 0.15s;
  }
  .current[data-live] { opacity: 1; }
  .hero:has(.current[data-live]) .fallback { opacity: 0; transition: opacity 0.9s ease; }
  ————————————————————————————————————————————————————————————————————— */

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.8fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    width: 100%;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: clamp(9.5px, 1.2vw, 11px);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--l2);
    margin-bottom: clamp(18px, 2.6vh, 26px);
  }

  h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--fs-display);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 15ch;
    text-wrap: balance;
    color: var(--l1);
  }
  /* One of exactly two gradient fills on the site. Large bold type, so 3:1 applies;
     this ramp measures 5.1:1 at its lightest stop. */
  h1 em {
    font-style: normal;
    /* held on one line so the gradient sweep is deterministic — across a line break
       each fragment gets its own slice of the ramp and the colour jumps */
    white-space: nowrap;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .sub {
    margin-top: clamp(18px, 2.6vh, 26px);
    font-size: var(--fs-lead);
    line-height: 1.62;
    max-width: 42ch;
    color: var(--l2);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
    margin-top: clamp(26px, 4vh, 40px);
  }

  /* ——— the surfer ——— */
  .art {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0;
  }

  /* The atmosphere the shader used to provide, reduced to what the artwork itself
     throws off: light spilling from a lit object onto paper. Sampled from the
     render — pink at the spray, indigo in the trough, a warm edge low right. It is
     a ground, so it never animates on its own; it only answers the scroll. */
  .bloom {
    position: absolute;
    z-index: -1;
    inset: -16% -20%;
    background:
      radial-gradient(46% 42% at 62% 32%, rgba(234, 28, 130, 0.20), transparent 70%),
      radial-gradient(54% 50% at 38% 68%, rgba(63, 42, 134, 0.17), transparent 72%),
      radial-gradient(36% 34% at 74% 60%, rgba(255, 106, 77, 0.12), transparent 70%);
    filter: blur(26px);
  }

  .ride {
    /* sized off the viewport's HEIGHT: this is a tall portrait render in a section
       that is 100svh, so height is what can overflow. Width follows from the
       intrinsic ratio on the element. */
    height: min(68vh, 620px);
    width: auto;
    max-width: 100%;
  }

  /* 1 — the swell. Revealed bottom-up, so the wave rises into frame instead of
         fading in. No IntersectionObserver: the hero is above the fold at load,
         and waiting for an observer would cost it a frame. */
  @keyframes swell {
    from {
      clip-path: inset(74% 0 0 0);
      opacity: 0;
      transform: translateY(24px) scale(0.965);
    }
    to {
      clip-path: inset(0 0 0 0);
      opacity: 1;
      transform: none;
    }
  }
  :global(html.js-motion) .swell {
    animation: swell 1.15s var(--ease-tide) 0.15s both;
  }

  /* 2 — the ride. Drifts along the wave's tangent rather than straight up, which
         is the difference between a surfer and a balloon.
         ease-in-out, not --ease-tide: the house ease is asymmetric, and on a loop
         that puts a velocity step at the halfway keyframe. */
  @keyframes ride {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-0.55deg); }
    50%      { transform: translate3d(-9px, -13px, 0) rotate(0.6deg); }
  }
  :global(html.js-motion) .drift {
    animation: ride 11s ease-in-out infinite;
  }

  /* 3 — the descent. --hp is hero scroll progress, 0 at the top and 1 when the
         section has scrolled its own height. The artwork lags the page downward
         and rolls into the direction of travel, so scrolling reads as the surfer
         dropping down the face rather than the page sliding under a decal.
         Scoped to .js-motion, which is absent under prefers-reduced-motion — that
         is what makes this respect the setting without a second media query. */
  :global(html.js-motion) .ride {
    transform:
      translate3d(calc(var(--hp, 0) * 16px), calc(var(--hp, 0) * 52px), 0)
      rotate(calc(var(--hp, 0) * 2.2deg));
    will-change: transform;
  }
  :global(html.js-motion) .bloom {
    transform: scale(calc(1 + var(--hp, 0) * 0.1));
    opacity: calc(1 - var(--hp, 0) * 0.55);
  }

  @media (max-width: 900px) {
    .hero { padding: 116px 0 72px; min-height: auto; }
    .inner { grid-template-columns: 1fr; gap: 28px; }
    h1 { max-width: 14ch; }
    /* portrait art in a single column: cap it so it cannot push the CTAs off the
       first screen on a short phone */
    .ride { height: clamp(280px, 44vh, 420px); }
    .bloom { inset: -10% -14%; }
  }
  @media (max-width: 520px) {
    .ctas > * { flex: 1 1 100%; justify-content: center; }
    .ride { height: clamp(250px, 38vh, 360px); }
  }
</style>

{/* ——— PREVIOUS HERO: the WebGL current ———————————————————————————————
    Parked with the markup and styles above. Commenting this out is what keeps
    src/scripts/fluid.ts out of the bundle entirely.

<script>
  import { initFluid } from '../scripts/fluid';
  const c = document.querySelector<HTMLCanvasElement>('[data-fluid]');
  if (c) initFluid(c);
</script>
————————————————————————————————————————————————————————————————————— */}
