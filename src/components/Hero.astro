---
import { waLink } from '../data/site';
import art from '../data/hero-art.json';

/*
 * Full-bleed hero, per the client: the render is the background now, not an object
 * beside the copy, and the headline runs the width of the page.
 *
 * That flips the hero to a DARK chapter at the top of a light-first page, which has
 * two consequences worth knowing before editing:
 *
 *  - .tone-dark is on the section, so --l1/--l2/--l3 and --grad-text resolve to their
 *    on-ink values. The accent words pick up --grad-on-dark rather than the paper
 *    ramp, whose dark end measures 1.6:1 here and would simply disappear.
 *
 *  - The section has to hand over to the paper below it. The usual .to-light class
 *    paints that ramp as the section's own background-image, which the <img> would
 *    cover, so the same --ramp-ink-to-mid is composed into the scrim instead. Stats
 *    carries .from-dark and the two still meet at --tone-mid, which is what keeps
 *    the boundary invisible.
 *
 * The scrim is not decoration. Measured on the unscrimmed image, the band the
 * headline occupies means 89.6/255 — mid-tone, with a sunset near white at the left
 * — so white type over the raw picture would fail in exactly the place the eye goes
 * first. `node tools/hero.mjs --check` reprints those numbers.
 */

const srcset = art.sources.map((s) => `${s.src} ${s.w}w`).join(', ');
---

<section class="hero tone-dark" data-hero>
  <img
    class="bg"
    src={art.src}
    srcset={srcset}
    sizes="100vw"
    width={art.width}
    height={art.height}
    alt=""
    fetchpriority="high"
    decoding="async"
  />
  <div class="veil" aria-hidden="true"></div>
  <div class="handover" aria-hidden="true"></div>

  <div class="shell inner">
    <p class="eyebrow" data-reveal>Strategy. Creativity. Technology. Results.</p>

    {/* The client's own tagline, with the poster's emphasis: both "Brand" and
        "Social Waves" are accented there, so both carry the gradient here. */}
    <h1 data-reveal>
      Let&rsquo;s Surf Your <em>Brand</em> to the <em>Social Waves.</em>
    </h1>

    <p class="sub" data-reveal>
      A complete social media & digital marketing solution that builds and manages your brand's digital presence.
    </p>

    <div class="ctas" data-reveal>
      <a class="btn" href="#enquire">
        Book a discovery call
        <svg class="arw" width="15" height="10" viewBox="0 0 15 10" fill="none" aria-hidden="true">
          <path d="M0 5h13M9 1l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a class="btn-ghost" href={waLink()} target="_blank" rel="noopener">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.16c-.24.68-1.2 1.26-1.97 1.42-.53.11-1.21.2-3.51-.75-2.95-1.22-4.84-4.21-4.99-4.4-.14-.2-1.19-1.58-1.19-3.02s.76-2.14 1.03-2.43c.27-.29.58-.37.78-.37.19 0 .39 0 .56.01.18.01.42-.07.66.5.24.58.82 2.01.89 2.16.07.14.12.31.02.51-.1.19-.15.31-.29.48-.15.17-.31.38-.44.51-.15.14-.3.3-.13.59.17.29.76 1.25 1.63 2.02 1.12.99 2.06 1.3 2.35 1.45.29.14.46.12.63-.07.17-.2.73-.85.92-1.14.19-.29.39-.24.65-.15.27.1 1.69.8 1.98.94.29.15.48.22.55.34.07.12.07.7-.17 1.39z" />
        </svg>
        WhatsApp us
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: clamp(104px, 14vh, 148px) 0 clamp(96px, 16vh, 190px);
    overflow: hidden;
    background-color: var(--ink-deep);
  }

  .bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The subject sits centre-right. On a phone the frame crops to roughly a third
       of the width, and centring it would land on empty sky. */
    object-position: 58% 50%;
    /* The descent: the picture lags the page, so the hero pulls apart as it leaves.
       Scale is only as much headroom as the travel needs — it was 1.06, which threw
       away 6% of the frame on top of what `cover` already crops, and this artwork is
       1.5:1 against a ~1.6:1 viewport, so `cover` alone loses barely any of it. */
    transform: scale(1.03) translate3d(0, calc(var(--hp, 0) * -1.8%), 0);
    will-change: transform;
  }

  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      /* 1. darken behind the nav so the mark and the links keep their contrast */
      linear-gradient(180deg, rgba(12, 6, 32, 0.8) 0%, rgba(12, 6, 32, 0.1) 18%, transparent 30%),
      /* 2. a pool under the copy, and now the only heavy darkening on the frame.
            The icon cluster the headline crosses is the brightest thing in the
            picture, and the accent words are set in the ON-INK ramp whose light end
            is #ff6fa8 — over lit pink icons that has almost nothing to separate it
            from its ground. Held to an ellipse around the copy so the darkening
            pays for legibility and nothing else. */
      radial-gradient(62% 46% at 50% 41%, rgba(12, 6, 32, 0.82), rgba(12, 6, 32, 0.34) 62%, transparent 82%),
      /* 3. A light touch over the sunrise rather than the flat 0.6 wash that was
            here. That wash was the single biggest reason the picture read as half
            hidden — it is the warmest thing in the frame and it was being erased to
            protect text that sits above it, not on it. */
      linear-gradient(90deg, rgba(12, 6, 32, 0.3) 0%, rgba(12, 6, 32, 0.06) 42%, transparent 64%),
      /* 4. The base veil. Light across the picture, and it only goes near-solid in
            the last stretch, where the handover has to start from the colour the
            image has already arrived at. */
      linear-gradient(180deg,
        rgba(12, 6, 32, 0.2) 0%,
        rgba(12, 6, 32, 0.26) 48%,
        rgba(12, 6, 32, 0.38) 76%,
        rgba(12, 6, 32, 0.72) 90%,
        rgba(12, 6, 32, 0.95) 100%);
  }

  /* The tonal handover to the paper below, as its own element so it can be masked.
     Layered into .veil it was an OPAQUE ramp starting at #0c0620 against a lighter
     scrimmed image, which drew exactly the hard horizontal line this system exists
     to prevent. Fading its first third in removes the edge; by the time it is fully
     opaque the ramp and the image have converged on ink anyway. */
  /* Was a flat var(--fade-h) — 300px of a 900px hero, a third of the picture spent
     on a ramp. It is a share of the section now, so the artwork keeps the rest.
     Compressing ink→mid into ~110px is steeper but not a step: across that distance
     the ramp moves under one level per row against a 14/channel budget, and
     qa/seams.mjs measures rows, not slopes. */
  .handover {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: -1;
    height: clamp(78px, 12%, 150px);
    background-image: var(--ramp-ink-to-mid);
    background-size: 100% 100%;
    background-repeat: no-repeat;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 52%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 52%);
  }

  /* ——— the copy, centred and full width ——— */
  .inner {
    position: relative;
    text-align: center;
    display: grid;
    justify-items: center;
    width: 100%;
  }

  .eyebrow {
    font-family: var(--label);
    font-size: clamp(9.5px, 1.2vw, 11.5px);
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--t2);
    margin-bottom: clamp(18px, 2.6vh, 28px);
  }

  /* Its own scale rather than --fs-display: that token is bounded by the service
     pages, where the headline shares its row with body copy. Here it has the full
     measure and the client asked it to fill the width. */
  h1 {
    font-family: var(--display);
    font-weight: var(--w-display);
    font-size: clamp(2.5rem, 7.4vw, 6.1rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
    /* wide enough to run edge to edge, capped so it never sets a one-word line */
    max-width: 17ch;
    text-wrap: balance;
    color: var(--t1);
    /* A halo, so each glyph carries a little ground of its own. The accent words are
       set in --grad-on-dark, whose light end is #ff6fa8, and where they cross the lit
       icon cluster the ground behind them measured 1.5:1 against a 3:1 floor for
       large text — darkening the whole picture enough to fix that would undo the
       point of showing it.

       filter, NOT text-shadow. The accent words are painted with background-clip:
       text over color: transparent, which means the gradient is a BACKGROUND and the
       shadow is part of the text layer above it — a text-shadow paints straight over
       the fill and turns both words black. drop-shadow applies to the rendered
       result, so the halo lands behind the glyphs where it belongs. */
    filter:
      drop-shadow(0 1px 2px rgba(6, 2, 18, 0.75))
      drop-shadow(0 3px 16px rgba(6, 2, 18, 0.8))
      drop-shadow(0 0 44px rgba(6, 2, 18, 0.55));
  }
  h1 em {
    background-image: var(--grad-text);
  }

  .sub {
    margin-top: clamp(18px, 2.6vh, 28px);
    font-size: var(--fs-lead);
    line-height: 1.6;
    max-width: 52ch;
    color: var(--t2);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 13px;
    margin-top: clamp(26px, 4vh, 42px);
  }

  @media (max-width: 900px) {
    .hero { padding: clamp(96px, 13vh, 120px) 0 clamp(88px, 14vh, 150px); }
    .bg { object-position: 62% 50%; }
    h1 { max-width: 13ch; }
  }
  @media (max-width: 520px) {
    .ctas > * { flex: 1 1 100%; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg { transform: scale(1.06); }
  }
</style>
