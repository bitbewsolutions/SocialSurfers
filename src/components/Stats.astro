---
import { stats } from '../data/content';

/* The numbers that used to run along the bottom edge of the hero.
   Set in the gradient at display size, per the client — which is why the figure and
   its suffix are separate elements: `background-clip: text` paints one box across
   the whole element, so a "+" inside it would take a slice of the ramp meant for a
   digit and land a different colour than the number it belongs to. */
/* Every figure carries a "+" at the client's request — he does not want the site
   fixing a ceiling he has already passed. Two of the four are derived from real
   counts; see the note on `stats` in data/content.ts for which and why. */

/*
 * The growth motif the client asked for ("emojis, charts, icons — you figure it
 * out"). This is the place for it and it only needed one answer: the section is four
 * numbers that all describe growth, and a rising bar chart is the plainest possible
 * drawing of that. So each tile becomes a small KPI card — chart, figure, label.
 *
 * Not emoji, deliberately. 📈 renders as a different picture on Android, iOS, Windows
 * and Samsung, cannot take the brand ramp, and sits next to a hand-built wordmark
 * looking like clip art. These bars are the site's own gradient, walked left to
 * right across the chart, so the motif is the brand rather than a sticker on it.
 *
 * Profiles differ per tile so the row does not read as one shape stamped four times,
 * and every one of them ends on its tallest bar — a chart that dips at the end is
 * telling the visitor something nobody meant to say.
 */
const figures = [
  { n: stats.projectsDelivered, l: 'Projects delivered', bars: [26, 40, 34, 62, 84, 100] },
  { n: stats.brands, l: 'Brands served', bars: [20, 33, 55, 48, 74, 100] },
  { n: stats.industriesServed, l: 'Industries served', bars: [32, 28, 51, 66, 79, 100] },
  { n: stats.serviceLines, l: 'Services offered', bars: [18, 42, 38, 58, 80, 100] },
];
---

{/* .from-dark is the second half of the hero's tonal handover. The hero paints
    ink→mid into its own scrim (it cannot use .to-light, whose ramp the background
    image would cover); this finishes mid→paper. Mismatch the pair and the join
    shows as a step. */}
<section class="stats from-dark" aria-label="Social Surfers by the numbers">
  <div class="shell">
    <dl>
      {figures.map((f) => (
        <div class="fig" data-reveal data-reveal-group="stat">
          {/* aria-hidden: it is the same information as the figure below it, drawn.
              A screen reader announcing six unlabelled bars before every number
              would be pure noise. */}
          <span class="spark" aria-hidden="true">
            {f.bars.map((h, i) => (
              <i style={`--h:${h}%;--c:${Math.round((i / (f.bars.length - 1)) * 100)}%;--d:${(i * 0.07).toFixed(2)}s`}></i>
            ))}
          </span>

          {/* The final value is the element's text, so it is what a visitor without
              JS, a crawler and the accessibility tree all read. The counter only
              overwrites it while running, and puts it back at the end. */}
          <dt>
            <span class="n" data-count={f.n}>{f.n}</span><span class="sfx">+</span>
          </dt>
          <dd class="label">{f.l}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stats {
    /* background-COLOR, not the shorthand: .from-dark delivers the ramp as a
       background-image, and `background: var(--paper)` would reset it to none. */
    background-color: var(--paper);
    /* The figure tiles are opaque paper — that is how the 1px grid lines are drawn,
       by letting the hair-coloured <dl> show through the gaps. So they cannot sit
       ON the ramp: the tile's flat paper against the ramp's mid-purple is a hard
       edge, which is exactly what seams.mjs caught at 186px in. Content clears the
       ramp completely rather than the usual 75%, and the ramp is shortened to keep
       that from becoming a canyon.
       Shortening is safe: the two halves of a boundary must meet at --tone-mid, and
       they still do — only the distance each takes to get there differs. */
    --fade-h: 230px;
    padding-block: var(--fade-h) clamp(28px, 5vh, 56px);
    color: var(--l1);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--hair);
    border-block: 1px solid var(--hair);
  }
  .fig {
    background: var(--paper);
    padding: clamp(20px, 3vh, 34px) clamp(14px, 2vw, 26px) clamp(22px, 3vh, 32px);
    display: grid;
    gap: 10px;
    align-content: start;
  }

  /* ——— the chart ———
     Bars grow with transform, not height, so nothing in this section triggers layout
     while it animates — the same rule the rest of the page's motion follows.
     Each bar takes its own point on the brand ramp by index, so the chart walks
     violet→rose the way --grad does; a per-bar `background: var(--grad)` would have
     given every bar the whole ramp compressed into 7px, which is a flat fill. */
  .spark {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: clamp(26px, 3.4vh, 38px);
    margin-bottom: 2px;
  }
  .spark i {
    display: block;
    width: clamp(6px, 0.8vw, 9px);
    height: var(--h);
    border-radius: 2px;
    background: color-mix(in oklab, var(--violet), var(--rose) var(--c));
    transform-origin: bottom;
    transition: transform 0.7s var(--ease-tide) var(--d);
  }
  /* Visible by default and only hidden once JS has confirmed it can animate — the
     same contract as [data-reveal]. Without JS, or with motion turned down, the
     chart is simply drawn. */
  :global(html.js-motion) .spark i { transform: scaleY(0); }
  :global(html.js-motion) .fig.is-in .spark i { transform: scaleY(1); }

  .fig dt {
    display: flex;
    align-items: baseline;
    font-family: var(--display);
    font-weight: var(--w-display);
    font-size: clamp(2.3rem, 5.6vw, 4.3rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    /* tabular figures so the column does not jitter while the counter runs */
    font-variant-numeric: tabular-nums;
  }
  /* Each part takes its own slice of the ramp on purpose — see the note above. */
  .fig dt .n,
  .fig dt .sfx {
    background-image: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .fig dt .sfx { font-size: 0.6em; }

  .fig dd {
    color: var(--l2);
    line-height: 1.35;
  }

  @media (max-width: 760px) {
    .stats { --fade-h: 190px; padding-block: var(--fade-h) clamp(20px, 4vh, 40px); }
    dl { grid-template-columns: repeat(2, 1fr); }
    .fig { padding: 20px 14px 22px; }
  }
</style>
