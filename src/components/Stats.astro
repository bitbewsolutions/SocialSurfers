---
import { stats } from '../data/content';

/* The numbers that used to run along the bottom edge of the hero.
   Set in the gradient at display size, per the client — which is why the figure and
   its suffix are separate elements: `background-clip: text` paints one box across
   the whole element, so a "+" inside it would take a slice of the ramp meant for a
   digit and land a different colour than the number it belongs to. */
const figures = [
  { n: stats.projectsDelivered, suffix: '+', l: 'Projects delivered' },
  { n: stats.brands, suffix: '+', l: 'Brands served' },
  { n: stats.industriesServed, suffix: '', l: 'Industries served' },
  { n: stats.serviceLines, suffix: '', l: 'Services offered' },
];
---

<section class="stats" aria-label="Social Surfers by the numbers">
  <div class="shell">
    <dl>
      {figures.map((f) => (
        <div class="fig" data-reveal data-reveal-group="stat">
          {/* The final value is the element's text, so it is what a visitor without
              JS, a crawler and the accessibility tree all read. The counter only
              overwrites it while running, and puts it back at the end. */}
          <dt>
            <span class="n" data-count={f.n}>{f.n}</span>
            {f.suffix && <span class="sfx">{f.suffix}</span>}
          </dt>
          <dd class="label">{f.l}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stats {
    background: var(--paper);
    padding-block: clamp(16px, 3vh, 36px) clamp(28px, 5vh, 56px);
    color: var(--l1);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--hair);
    border-block: 1px solid var(--hair);
  }
  .fig {
    background: var(--paper);
    padding: clamp(20px, 3vh, 34px) clamp(14px, 2vw, 26px) clamp(22px, 3vh, 32px);
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .fig dt {
    display: flex;
    align-items: baseline;
    font-family: var(--display);
    font-weight: var(--w-display);
    font-size: clamp(2.3rem, 5.6vw, 4.3rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    /* tabular figures so the column does not jitter while the counter runs */
    font-variant-numeric: tabular-nums;
  }
  /* Each part takes its own slice of the ramp on purpose — see the note above. */
  .fig dt .n,
  .fig dt .sfx {
    background-image: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .fig dt .sfx { font-size: 0.6em; }

  .fig dd {
    color: var(--l2);
    line-height: 1.35;
  }

  @media (max-width: 760px) {
    .stats { padding-block: 4px clamp(20px, 4vh, 40px); }
    dl { grid-template-columns: repeat(2, 1fr); }
    .fig { padding: 20px 14px 22px; }
  }
</style>
