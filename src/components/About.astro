---
import { about, solutions } from '../data/content';
import { site } from '../data/site';

/*
 * The brochure's About spread, brought over more or less as the client drew it:
 * heading and two paragraphs on the left, the category line and its three points on
 * the right, and the handwritten line closing the left column.
 *
 * It is also where the page stops being white. The three sections above it are all
 * plain paper, which is what the client was reacting to — so this one carries a
 * gradient wash. The wash is masked to zero at both edges rather than simply fading
 * by eye, because the sections above and below are flat paper and any residual tint
 * at the boundary is a hard step: exactly what qa/seams.mjs exists to catch.
 */

const icons = {
  target: 'M12 3a9 9 0 1 0 9 9M12 7.5a4.5 4.5 0 1 0 4.5 4.5M12 12l7-7M19 5V2.5M19 5h2.5',
  bubble: 'M4 5.5h16v11H9.5L5 20.5v-4H4z M8.5 11h.01 M12 11h.01 M15.5 11h.01',
  chart: 'M4 20h16 M7.5 20v-6 M12 20V6.5 M16.5 20v-9',
};
---

<section class="about" id="about" aria-labelledby="about-h">
  <div class="wash" aria-hidden="true"></div>

  <div class="shell grid">
    <div class="col">
      <h2 class="h2" id="about-h" data-reveal>About <em>Us</em></h2>

      {about.body.map((p) => (
        <p class="body" data-reveal data-reveal-group="about">{p}</p>
      ))}

      {/* The handwritten line. It writes itself on rather than fading in — the
          generic reveal is overridden below so the wipe is the only thing that
          happens, otherwise the fade gives the ending away before the stroke
          reaches it. */}
      <p class="voice" data-reveal aria-label={site.voiceLine}>
        <span class="ln a" aria-hidden="true">We don&rsquo;t just manage,</span>
        <span class="ln b" aria-hidden="true">
          We Grow Brands!
          <svg class="swash" viewBox="0 0 260 14" fill="none" aria-hidden="true" preserveAspectRatio="none">
            <path
              d="M2 8.5C46 3.5 96 2.5 140 4.5c38 1.7 74 5 118 2"
              stroke="url(#swashg)"
              stroke-width="3"
              stroke-linecap="round"
              pathLength="1"
            />
            <defs>
              <linearGradient id="swashg" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#3f2a86" />
                <stop offset="1" stop-color="#ea1c82" />
              </linearGradient>
            </defs>
          </svg>
        </span>
      </p>
    </div>

    <div class="col side">
      <h3 class="cat" data-reveal>{site.category}</h3>
      <span class="rule" aria-hidden="true"></span>

      <ul class="points">
        {solutions.map((s) => (
          <li data-reveal data-reveal-group="sol">
            <span class="disc" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                   stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[s.icon]} />
              </svg>
            </span>
            <span class="txt">{s.text}</span>
          </li>
        ))}
      </ul>

      {/* The growth picture, and it is a picture of the SENTENCE opposite it.

          The client asked for something visible that implies growth, near the
          handwritten "We don't just manage, We Grow Brands!". Two lines is the
          whole idea: a flat one that drifts sideways and goes nowhere, and a rising
          one that does not. That is literally the difference the line claims, so the
          graphic argues the same thing the copy does instead of decorating it.

          Deliberately unitless — no axis, no figures, no percentages. It illustrates
          a positioning statement, and the moment it carries a number it is claiming
          a result nobody measured.

          It sits in this column rather than under the handwriting because the right
          column ended two thirds of the way down and left a visible hole beside it.
          On a phone the columns stack and it lands just below the line it belongs to. */}
      <figure class="growth" data-reveal>
        <svg viewBox="0 0 320 128" role="img" aria-label="Two paths from the same starting point: one stays flat when social media is only managed, one climbs when the brand is grown.">
          <defs>
            {/* runs bottom-left to top-right, so the ramp climbs with the line */}
            <linearGradient id="growLine" x1="0" y1="1" x2="1" y2="0">
              <stop class="g0" offset="0" />
              <stop class="g1" offset="1" />
            </linearGradient>
            <radialGradient id="growGlow">
              <stop class="gl0" offset="0" />
              <stop class="gl1" offset="1" />
            </radialGradient>
          </defs>

          <circle class="glow" cx="298" cy="22" r="40" />

          {/* Both paths open on EXACTLY M18 112. That shared origin is the whole
              graphic: same business, same month, two outcomes. The first version
              started them four units apart, which read as two loose ends and a
              drawing mistake — which is what it was. */}
          <path
            class="ln-flat"
            pathLength="1"
            d="M18 112C62 110 78 118 118 115S174 108 214 112S270 116 298 111"
          />
          <path
            class="ln-rise"
            pathLength="1"
            d="M18 112C92 108 142 98 182 78S258 44 298 22"
          />

          <circle class="origin" cx="18" cy="112" r="4.4" />
          <circle class="tail" cx="298" cy="111" r="3.4" style="--d:0.7s" />
          <circle class="step" cx="182" cy="78" r="4" style="--d:1.05s" />
          <g class="head" style="--d:1.3s">
            <circle class="halo" cx="298" cy="22" r="12" />
            <circle class="dot" cx="298" cy="22" r="5.6" />
          </g>
        </svg>

        <figcaption class="legend">
          <span class="lg flat"><i aria-hidden="true"></i>Just managed</span>
          <span class="lg up"><i aria-hidden="true"></i>Grown</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    isolation: isolate;
    background: var(--paper);
    padding-block: var(--section-y);
    overflow: hidden;
  }

  /* The colour. Masked to nothing at the top and bottom edges so the section meets
     the flat paper above and below at exactly paper, with no step to find. */
  .wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(58% 52% at 14% 26%, rgba(63, 42, 134, 0.20), transparent 72%),
      radial-gradient(52% 48% at 88% 64%, rgba(234, 28, 130, 0.17), transparent 72%),
      radial-gradient(46% 44% at 52% 96%, rgba(255, 106, 77, 0.10), transparent 70%);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 16%, #000 84%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 16%, #000 84%, transparent);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .col { min-width: 0; }

  .h2 { margin-bottom: clamp(20px, 3vh, 32px); }

  .body {
    font-size: var(--fs-lead);
    line-height: 1.66;
    color: var(--l2);
    max-width: 46ch;
  }
  .body + .body { margin-top: 18px; }

  /* ——— the handwritten line ——— */
  .voice {
    margin-top: clamp(28px, 4vh, 44px);
    font-family: var(--script);
    font-weight: 700;
    font-size: clamp(1.75rem, 3.6vw, 2.9rem);
    line-height: 1.16;
    display: grid;
    justify-items: start;
  }
  .ln {
    display: block;
    /* the wipe's resting state; the reveal opens it */
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.85s var(--ease-tide);
  }
  .ln.a { color: var(--violet); }
  .ln.b {
    position: relative;
    color: var(--rose);
    padding-right: 0.12em;
    transition-delay: 0.55s;
  }

  .swash {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.16em;
    width: 100%;
    height: 0.38em;
  }
  .swash path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.7s var(--ease-out) 1.15s;
  }

  /* The generic reveal would fade the whole line in and pre-empt the wipe, so this
     element opts out of the transform/opacity half of it and keeps only the trigger. */
  :global(html.js-motion) .voice {
    opacity: 1;
    transform: none;
  }
  :global(html.js-motion) .voice .ln { clip-path: inset(0 100% 0 0); }
  :global(html.js-motion) .voice.is-in .ln { clip-path: inset(0 -8% 0 0); }
  :global(html.js-motion) .voice.is-in .swash path { stroke-dashoffset: 0; }
  /* No JS, or motion turned down: the line is simply there, fully drawn. */
  :global(html:not(.js-motion)) .voice .ln { clip-path: none; }
  :global(html:not(.js-motion)) .voice .swash path { stroke-dashoffset: 0; }

  /* ——— the three points ——— */
  .cat {
    font-family: var(--display);
    font-weight: var(--w-display);
    font-size: var(--fs-h3);
    line-height: 1.16;
    letter-spacing: -0.018em;
    color: var(--l1);
    max-width: 18ch;
  }
  .rule {
    display: block;
    width: 68px;
    height: 3px;
    margin: 18px 0 26px;
    border-radius: 99px;
    background: var(--grad);
  }

  .points { display: grid; gap: 20px; }
  .points li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 15px;
  }
  .disc {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex: none;
    border-radius: 50%;
    background: var(--grad);
    color: #fff;
    box-shadow: 0 10px 24px -12px rgba(63, 42, 134, 0.75);
  }
  .disc svg { width: 21px; height: 21px; }
  .txt {
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--l1);
  }

  /* ——— the growth chart ——— */
  .growth {
    margin-top: clamp(30px, 5vh, 52px);
    display: grid;
    gap: 14px;
  }
  .growth svg { width: 100%; height: auto; overflow: visible; }

  /* Colours live here rather than on the elements: a `stroke="var(--rose)"`
     presentation attribute is not reliable across browsers, and these have to
     follow the tokens — this section is light today and the ramp would be wrong on
     ink. `stop-color` is the one place a CSS custom property has to be applied
     through a class rather than inline. */
  /* No gridlines, no axis, no area fill. All three were chart FURNITURE, and their
     only effect was to make a conceptual drawing pose as measured data — which is
     what made it read as forced. What is left is the argument: one origin, two
     outcomes. The glow gives the graphic presence without pretending to plot
     anything. */
  .g0 { stop-color: var(--violet); }
  .g1 { stop-color: var(--rose); }
  .gl0 { stop-color: var(--rose); stop-opacity: 0.16; }
  .gl1 { stop-color: var(--rose); stop-opacity: 0; }

  .glow { fill: url(#growGlow); }

  /* ln- prefix, because .flat is also the legend swatch class in this file */

  /* The dotted texture has to be expressed as a FRACTION OF THE PATH.
     `pathLength="1"` rescales every dash unit so the whole line measures 1, so the
     plain `3 5` that was here meant a dash three times longer than the line itself
     — it rendered solid, in both the animated and the no-JS state. ~0.014 of a
     ~290-unit path is the 4px dash it was meant to be. Change the path and these
     want re-checking. */
  .ln-flat {
    fill: none;
    stroke: var(--l3);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 0.014 0.019;
    opacity: 0.5;
  }
  .ln-rise {
    fill: none;
    stroke: url(#growLine);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The shared start, so it belongs to neither line and takes a neutral colour.
     It is also the one mark with no entrance delay — the fork cannot happen
     before the point it forks from. */
  .origin { fill: var(--paper); stroke: var(--l3); stroke-width: 2.2; }
  .tail { fill: var(--l3); opacity: 0.5; }
  .step { fill: var(--paper); stroke: var(--rose); stroke-width: 2.4; }
  .head .dot { fill: var(--rose); }
  .head .halo { fill: var(--rose); opacity: 0.16; }

  /* Motion, on the same contract as [data-reveal]: drawn by default, hidden only
     once .js-motion confirms JS can animate it, so no-JS and reduced-motion both
     get the finished chart. The flat line draws FIRST and fast — it is the
     "before", and the rising line reads as the answer to it. */
  :global(html.js-motion) .growth .ln-flat,
  :global(html.js-motion) .growth .ln-rise {
    /* pathLength="1" normalises both paths, so one dash length draws either of
       them regardless of how long they actually are */
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1s var(--ease-out);
  }
  /* The flat line loses its dotted texture while it draws — one dash cannot both
     be the pattern and be the reveal. It gets it back at rest, below. */
  :global(html.js-motion) .growth .ln-flat { transition-duration: 0.7s; }
  :global(html.js-motion) .growth .ln-rise { transition-delay: 0.35s; }
  :global(html.js-motion) .growth .glow { opacity: 0; transition: opacity 0.9s ease 1.35s; }
  :global(html.js-motion) .growth .origin,
  :global(html.js-motion) .growth .tail,
  :global(html.js-motion) .growth .step,
  :global(html.js-motion) .growth .head {
    opacity: 0;
    transform: scale(0.2);
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 0.3s ease var(--d, 0.1s), transform 0.45s var(--ease-out) var(--d, 0.1s);
  }
  :global(html.js-motion) .growth.is-in .ln-flat,
  :global(html.js-motion) .growth.is-in .ln-rise { stroke-dashoffset: 0; }
  /* restore the dotted texture once it has finished drawing */
  :global(html.js-motion) .growth.is-in .ln-flat {
    stroke-dasharray: 0.014 0.019;
    transition: stroke-dashoffset 0.7s var(--ease-out), stroke-dasharray 0s linear 0.7s;
  }
  :global(html.js-motion) .growth.is-in .glow { opacity: 1; }
  :global(html.js-motion) .growth.is-in .origin,
  :global(html.js-motion) .growth.is-in .tail,
  :global(html.js-motion) .growth.is-in .step,
  :global(html.js-motion) .growth.is-in .head { opacity: 1; transform: scale(1); }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .lg {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--label);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--l3);
  }
  .lg i { width: 18px; height: 3px; border-radius: 99px; flex: none; }
  /* dashed, so the swatch is the line it names rather than a generic bar */
  .lg.flat i {
    border-radius: 0;
    background: repeating-linear-gradient(90deg, var(--l3) 0 4px, transparent 4px 7px);
    opacity: 0.55;
  }
  .lg.up i { background: var(--grad); }
  .lg.up { color: var(--l2); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; gap: 44px; }
    .cat { max-width: none; }
    /* the columns stack here, which puts the chart directly under the handwritten
       line — closer to where the client asked for it than the desktop layout can be */
    .growth { margin-top: clamp(26px, 4vh, 36px); }
  }
</style>
