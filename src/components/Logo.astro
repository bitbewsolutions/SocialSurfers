---
/**
 * The real brand mark, rebuilt as vector.
 *
 * The client supplied a 400x400 PNG. Its geometry turned out to be exact and simple —
 * fitting circles to the traced edges gives two discs of identical radius sharing a
 * centre-x, their centres one radius apart: the upper one minus its bottom-right
 * quadrant, the lower minus its top-left. That interlock is the S.
 *
 * So this is ~500 bytes of path data instead of a 14.5 KB raster, it is crisp at any
 * size including the favicon, and the two brand colours become tokens rather than
 * being baked into pixels.
 */
interface Props {
  size?: number;
  /** Hide the wordmark, e.g. in tight spaces. */
  markOnly?: boolean;
}
const { size = 34, markOnly = false } = Astro.props;
---

<span class="logo" style={`--mark:${size}px`}>
  <svg viewBox="0 0 242 365" aria-hidden="true" focusable="false">
    <path
      class="upper"
      d="M121 0 A121 121 0 0 1 242 121 L121 121 L121 242 A121 121 0 0 1 0 121 A121 121 0 0 1 121 0 Z"
    />
    <path
      class="lower"
      d="M121 123 A121 121 0 0 1 242 244 A121 121 0 0 1 121 365 A121 121 0 0 1 0 244 L121 244 Z"
    />
  </svg>
  {/* The wordmark is the brand lockup, so it keeps the client's exact pink even
      though that measures 2.99:1 on paper. WCAG 1.4.3 exempts logotypes; the
      attribute declares that to qa/contrast.mjs rather than leaving the tool to
      guess or the failure to be ignored by hand every run. */}
  {!markOnly && <b data-contrast-exempt="logotype">Social<span>Surfers</span></b>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }
  .logo svg {
    /* the mark is taller than it is wide — 242:365 */
    height: var(--mark);
    width: calc(var(--mark) * 0.663);
    flex: none;
  }
  .upper { fill: var(--brand-indigo); }
  .lower { fill: var(--brand-pink); }

  .logo b {
    font-family: var(--display);
    font-weight: 700;
    font-size: calc(var(--mark) * 0.54);
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }
  .logo b span { color: var(--brand-pink); }
</style>
