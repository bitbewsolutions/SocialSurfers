---
/**
 * The real brand mark, rebuilt as vector.
 *
 * The client supplied a 400x400 PNG. Its geometry turned out to be exact and simple —
 * fitting circles to the traced edges gives two discs of identical radius sharing a
 * centre-x, their centres one radius apart: the upper one minus its bottom-right
 * quadrant, the lower minus its top-left. That interlock is the S.
 *
 * So this is ~500 bytes of path data instead of a 14.5 KB raster, it is crisp at any
 * size including the favicon, and the two brand colours become tokens rather than
 * being baked into pixels.
 */
import { site } from '../data/site';

interface Props {
  size?: number;
  /** Hide the wordmark, e.g. in tight spaces. */
  markOnly?: boolean;
  /** Set the category line under the wordmark. Nav and footer only. */
  tagline?: boolean;
}
const { size = 34, markOnly = false, tagline = false } = Astro.props;
---

{/* The inline value is --mark-LG, and the stylesheet derives --mark from it. That
    indirection is the whole reason the phone size below can exist: an inline custom
    property beats any selector, so a media query setting --mark directly would have
    been ignored and the wordmark would have stayed at its desktop size. */}
<span class="logo" style={`--mark-lg:${size}px`}>
  <svg viewBox="0 0 242 365" aria-hidden="true" focusable="false">
    <path
      class="upper"
      d="M121 0 A121 121 0 0 1 242 121 L121 121 L121 242 A121 121 0 0 1 0 121 A121 121 0 0 1 121 0 Z"
    />
    <path
      class="lower"
      d="M121 123 A121 121 0 0 1 242 244 A121 121 0 0 1 121 365 A121 121 0 0 1 0 244 L121 244 Z"
    />
  </svg>
  {/* The wordmark is the brand lockup, so it keeps the client's exact pink even
      though that measures 2.99:1 on paper. WCAG 1.4.3 exempts logotypes; the
      attribute declares that to qa/contrast.mjs rather than leaving the tool to
      guess or the failure to be ignored by hand every run.
      The two words are separated now, as they are on the poster — it set them on
      two lines, which is a space by another name. */}
  {!markOnly && (
    <span class="lockup">
      <b data-contrast-exempt="logotype">Social <span>Surfers</span></b>
      {tagline && <i class="cat">{site.category}</i>}
    </span>
  )}
</span>

<style>
  .logo {
    --mark: var(--mark-lg);
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }
  .logo svg {
    /* the mark is taller than it is wide — 242:365 */
    height: var(--mark);
    width: calc(var(--mark) * 0.663);
    flex: none;
  }
  .upper { fill: var(--brand-indigo); }
  .lower { fill: var(--brand-pink); }

  .lockup {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .logo b {
    font-family: var(--display);
    /* 900 to match the poster's wordmark, which is the heaviest thing on it */
    font-weight: 900;
    font-size: calc(var(--mark) * 0.46);
    letter-spacing: -0.022em;
    line-height: 1;
    white-space: nowrap;
  }
  .logo b span { color: var(--brand-pink); }

  /* The category line the client asked for under the mark. Deliberately quiet —
     it is a descriptor, and at nav size anything louder competes with the
     wordmark it is explaining. */
  .cat {
    font-family: var(--label);
    font-style: normal;
    font-weight: 700;
    font-size: calc(var(--mark) * 0.174);
    letter-spacing: 0.085em;
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--l3);
    white-space: nowrap;
  }

  /* On a phone the bar is the mark, the wordmark and the burger, and the category
     line does not fit between them — it ran under the burger. It is not lost: the
     same line is the heading of the right-hand column in the About section, at a
     size where it can actually be read. */
  @media (max-width: 900px) {
    .cat { display: none; }
  }

  /* A notch down on phones, per the client — the lockup was reading as the loudest
     thing in a 42px-tall bar. One factor rather than a second size prop: the mark,
     the wordmark and the category line are all derived from --mark, so they stay in
     proportion and the nav is not the only caller that has to be told about it.
     0.85 is deliberately small — he asked for "a little". */
  @media (max-width: 640px) {
    .logo { --mark: calc(var(--mark-lg) * 0.85); gap: 9px; }
  }
</style>
