---
import { clients, pillars, stats, hasRealTestimonials, testimonials } from '../data/content';

/* A double marquee, because the roster outgrew the wall.
   The bunting grid worked for six and would have worked for twenty; at twenty-seven
   it becomes four static rows nobody scans. Two counter-rotating tracks read as one
   continuous body of work and take any number of logos with no layout decision.

   Mechanics worth keeping:
   - Each track holds its row's tiles TWICE and translates by exactly -50%. That is
     what makes the loop seamless: at -50% the second copy sits precisely where the
     first started, so the reset to 0 is invisible. Any other duplication factor or
     travel distance visibly snaps.
   - Duration is derived from tile count, so both rows move at the same speed however
     many logos each carries. A fixed duration would make the shorter row race.
   - The duplicate copy is aria-hidden; the roster should be announced once. */

const half = Math.ceil(clients.length / 2);
const rows = [clients.slice(0, half), clients.slice(half)];
const SECONDS_PER_TILE = 3.6;
---

<section class="proof tone-dark to-light" id="clients">
  <div class="shell head">
    <p class="label" data-reveal>Our clients</p>
    <h2 class="h2" data-reveal>
      {stats.projectsDelivered}+ projects delivered<br /><em>for {stats.brands} brands.</em>
    </h2>
    <p class="lead" data-reveal>
      Gyms, salons, restaurants, real estate, architecture, retail, automotive
      &mdash; different businesses, the same way of working.
    </p>
  </div>

  <div class="marquees" data-reveal>
    {rows.map((row, i) => (
      <div class="marquee" data-dir={i % 2 === 0 ? 'fwd' : 'rev'}>
        <ul class="track" style={`--dur:${(row.length * SECONDS_PER_TILE).toFixed(1)}s`}>
          {row.map((c) => (
            <li class="tile">
              <img src={c.logo} alt={c.name} width="160" height="160" loading="lazy" decoding="async" />
            </li>
          ))}
          {row.map((c) => (
            <li class="tile" aria-hidden="true">
              <img src={c.logo} alt="" width="160" height="160" loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="shell">
    {hasRealTestimonials ? (
      <ul class="logs">
        {testimonials.map((t) => (
          <li class="log" data-reveal data-reveal-group="log">
            <blockquote>{t.quote}</blockquote>
            <footer>
              <b>{t.client}</b>
              <span>{t.business} &middot; {t.industry}</span>
              {t.result && <span class="result">{t.result}</span>}
            </footer>
          </li>
        ))}
      </ul>
    ) : (
      /* No real testimonials exist yet. Rather than ship invented quotes on a
         marketing agency's own site, this falls back to what we can stand behind. */
      <ul class="pillars">
        {pillars.map((p) => (
          <li data-reveal data-reveal-group="pil">
            <span class="k">{p}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  /* second half of the dark chapter; it ramps back out to paper at the bottom */
  .proof { padding-top: var(--section-y); }

  .head { display: grid; gap: 20px; }
  .head .h2 { max-width: 20ch; }

  .marquees {
    margin-top: clamp(44px, 7vh, 80px);
    display: grid;
    gap: clamp(12px, 1.6vw, 20px);
    /* the rows run full-bleed, so fade both ends into the ground rather than letting
       tiles be guillotined by the viewport edge */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
  }

  .marquee { overflow: hidden; }
  .track {
    display: flex;
    width: max-content;
    animation: slide var(--dur) linear infinite;
  }
  .marquee[data-dir='rev'] .track { animation-direction: reverse; }
  @keyframes slide {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }
  /* pausing on hover lets someone actually look at a logo they recognise */
  .marquees:hover .track { animation-play-state: paused; }

  .tile {
    flex: none;
    /* Spacing is per-tile margin, NOT flex gap. With gap, N tiles have N-1 gaps, so
       half the doubled track is one copy plus only half a gap — the loop lands half a
       gap short and visibly ticks every cycle. A trailing margin on every tile makes
       one copy exactly (tile + margin) x N, and -50% is exact. */
    margin-right: clamp(12px, 1.6vw, 20px);
    width: clamp(122px, 13vw, 168px);
    aspect-ratio: 1;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid var(--hair-ink-2);
    transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast);
  }
  .tile img { width: 100%; height: 100%; object-fit: cover; }
  .tile:hover { transform: translateY(-4px); border-color: var(--rose); }

  .pillars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--hair);
    border-block: 1px solid var(--hair);
    margin-top: clamp(48px, 8vh, 88px);
  }
  .pillars li {
    background: var(--paper);
    padding: 26px 20px;
    text-align: center;
  }
  .pillars .k {
    font-family: var(--mono);
    font-size: clamp(10px, 1.6vw, 12px);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--l2);
  }

  .logs {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-top: clamp(48px, 8vh, 88px);
  }
  .log {
    border: 1px solid var(--hair);
    border-left: 2px solid var(--rose);
    border-radius: var(--radius-sm);
    padding: 24px;
    background: var(--paper-2);
  }
  .log blockquote { font-size: 1rem; line-height: 1.6; color: var(--l1); }
  .log footer { margin-top: 16px; display: grid; gap: 3px; }
  .log footer b { font-family: var(--display); font-size: 1rem; }
  .log footer span { font-family: var(--mono); font-size: 9.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--l3); }
  .log .result { color: var(--rose); }

  @media (max-width: 860px) {
    .pillars { grid-template-columns: repeat(2, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    /* stop the travel and hand the row back as an ordinary scroller */
    .track { animation: none; }
    .marquee { overflow-x: auto; }
    .tile:hover { transform: none; }
  }
</style>
