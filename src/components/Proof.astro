---
import { projects, pillars, stats, hasRealTestimonials, testimonials } from '../data/content';

/* The wall replaces the single strip of bunting this section used to be.
   That strip was hard-built for six flags — it spaced them along one drooping cord,
   so the seventh would have squeezed and the fortieth was never possible.

   This is the same bunting idea rebuilt as a repeating grid: every row hangs from
   its own cord (a repeating background line pitched to exactly one row), and the
   pennant shape lives in the tile's clip-path. Six items or fifty, it just reflows —
   no geometry to recompute, no JS. When logo files land, the tile swaps its name
   for an <img> and the wall becomes a logo wall with no layout change. */

const unnamed = Math.max(0, stats.projectsDelivered - projects.length);
---

<section class="proof" id="clients">
  <div class="shell head">
    <p class="label" data-reveal>Our clients</p>
    <h2 class="h2" data-reveal>
      {stats.projectsDelivered}+ projects delivered.<br />Here are the ones we can name.
    </h2>
    <p class="lead" data-reveal>
      Gyms, real estate, retail, events and fashion &mdash; different businesses, the same
      way of working. Some clients are happy to be named, others would rather not be.
    </p>
  </div>

  <div class="shell">
    <ul class="wall">
      {projects.map((p) => (
        <li class="tile" data-reveal data-reveal-group="wall">
          {p.logo ? (
            <img src={p.logo} alt={p.name} width="120" height="44" loading="lazy" decoding="async" />
          ) : (
            <span class="nm">{p.name}</span>
          )}
          <span class="ind">{p.industry}</span>
        </li>
      ))}

      {unnamed > 0 && (
        <li class="tile rest" data-reveal data-reveal-group="wall">
          <span class="nm">+{unnamed}</span>
          <span class="ind">Names on request</span>
        </li>
      )}
    </ul>

    {hasRealTestimonials ? (
      <ul class="logs">
        {testimonials.map((t) => (
          <li class="log" data-reveal data-reveal-group="log">
            <blockquote>{t.quote}</blockquote>
            <footer>
              <b>{t.client}</b>
              <span>{t.business} &middot; {t.industry}</span>
              {t.result && <span class="result">{t.result}</span>}
            </footer>
          </li>
        ))}
      </ul>
    ) : (
      /* No real testimonials exist yet. Rather than ship invented quotes on a
         marketing agency's own site, this falls back to what we can stand behind. */
      <ul class="pillars">
        {pillars.map((p) => (
          <li data-reveal data-reveal-group="pil">
            <span class="k">{p}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .proof {
    background: var(--paper);
    color: var(--l1);
    padding-block: var(--section-y);
  }

  .head { display: grid; gap: 20px; }
  .head .h2 { max-width: 20ch; }

  /* ——— the wall ———
     One cord per row, drawn as a repeating background line whose period is exactly
     one row's pitch. Rows are fixed-height so that pitch is knowable in CSS alone,
     which is what lets the wall take six tiles or fifty without any recalculation. */
  .wall {
    --tile-h: 118px;
    --row-gap: 34px;
    margin-top: clamp(48px, 8vh, 92px);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(158px, 1fr));
    grid-auto-rows: var(--tile-h);
    column-gap: 9px;
    row-gap: var(--row-gap);
    background-image: repeating-linear-gradient(
      180deg,
      var(--hair-2) 0 1px,
      transparent 1px calc(var(--tile-h) + var(--row-gap))
    );
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    padding: 16px 11px 30px;
    /* flat, NOT the gradient: --grad is rationed to the hero accent and the primary
       button. Alternating solids also read more like real bunting than a repeated
       gradient does. */
    background: var(--violet);
    clip-path: polygon(0 0, 100% 0, 100% 66%, 50% 100%, 0 66%);
    transform-origin: top center;
    transition: transform var(--dur) var(--ease-out), filter var(--dur-fast);
  }
  /* alternating direction, so a long wall reads as bunting rather than a table */
  .tile:nth-child(even) { background: var(--rose); }
  .tile:hover { transform: rotate(-1.4deg); filter: brightness(1.1); }

  /* two lines' worth of box whether the name wraps or not, so the industry label
     sits on the same baseline right across a row */
  .tile .nm {
    display: flex;
    align-items: center;
    min-height: 2.2em;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(0.82rem, 1.4vw, 0.98rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: #fff;
    text-wrap: balance;
  }
  .tile .ind {
    font-family: var(--mono);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    /* 0.82 measured 4.21:1 on --rose and this is 8px text, so it needs 4.5 */
    color: rgba(255, 255, 255, 0.93);
  }
  .tile img { width: auto; max-height: 44px; object-fit: contain; }

  /* the not-yet-named remainder — deliberately reads as a placeholder, not a client */
  .tile.rest,
  .tile.rest:nth-child(even) {
    background: transparent;
    border: 1px dashed var(--hair-2);
    border-top: 0;
  }
  .tile.rest .nm { font-family: var(--mono); font-weight: 700; font-size: 1.15rem; color: var(--l2); }
  .tile.rest .ind { color: var(--l3); }
  .tile.rest:hover { transform: none; filter: none; }

  .pillars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--hair);
    border-block: 1px solid var(--hair);
    margin-top: clamp(48px, 8vh, 88px);
  }
  .pillars li {
    background: var(--paper);
    padding: 26px 20px;
    text-align: center;
  }
  .pillars .k {
    font-family: var(--mono);
    font-size: clamp(10px, 1.6vw, 12px);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--l2);
  }

  .logs {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-top: clamp(48px, 8vh, 88px);
  }
  .log {
    border: 1px solid var(--hair);
    border-left: 2px solid var(--rose);
    border-radius: var(--radius-sm);
    padding: 24px;
    background: var(--paper-2);
  }
  .log blockquote { font-size: 1rem; line-height: 1.6; color: var(--l1); }
  .log footer { margin-top: 16px; display: grid; gap: 3px; }
  .log footer b { font-family: var(--display); font-size: 1rem; }
  .log footer span { font-family: var(--mono); font-size: 9.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--l3); }
  .log .result { color: var(--rose); }

  @media (max-width: 860px) {
    .wall {
      --tile-h: 104px;
      --row-gap: 28px;
      grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
    }
    .pillars { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 420px) {
    .wall { grid-template-columns: repeat(2, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile:hover { transform: none; }
  }
</style>
