---
/**
 * Scroll-driven ribbon divider.
 *
 * The ribbon pans left→right as you scroll past it. It is NOT a marquee: the travel
 * is bound to scroll position, not to a clock, so it moves only while you do and
 * reverses when you scroll back. That is also why the source image not tiling
 * doesn't matter — measured, its left and right edges differ by 152/255, so it could
 * never loop, but a bounded pan never needs to. The edges are masked into the paper
 * so the ribbon has no visible start or end regardless.
 *
 * --p comes from initSectionProgress() (data-progress), the same mechanism that
 * draws the process chart. The image is wider than its frame; --p slides it across
 * the surplus.
 *
 * TODO(client): the artwork is an AI render and, like the hero image, uses Meta /
 * YouTube / TikTok marks as decorative 3D objects. Those companies' brand guidelines
 * restrict that. Worth replacing with the agency's own work before launch — the
 * component takes any wide image, so it is a file swap.
 */
---

<div class="divider" data-progress data-progress-anchor="0.5" aria-hidden="true">
  <div class="frame">
    <img
      src="/art/ribbon-1248.webp"
      srcset="/art/ribbon-760.webp 760w, /art/ribbon-1248.webp 1248w"
      sizes="(max-width: 760px) 150vw, 130vw"
      width="1248"
      height="742"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>
</div>

<style>
  .divider {
    position: relative;
    overflow: hidden;
    background: var(--paper);
    /* The artwork is ~2:1 even after trimming its empty margins, so a thin band
       would crop the S-curve away entirely. It needs real height to read. */
    height: clamp(230px, 28vw, 400px);
  }

  /* The mask belongs on the FRAME, not the image. The image is deliberately wider
     than the viewport so it has surplus to pan across, which put its own 14%/86%
     fade off-screen and left a hard cut at the viewport edge instead. */
  .frame {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    -webkit-mask-image:
      linear-gradient(90deg, transparent, #000 16%, #000 84%, transparent),
      linear-gradient(180deg, transparent, #000 20%, #000 80%, transparent);
    mask-image:
      linear-gradient(90deg, transparent, #000 16%, #000 84%, transparent),
      linear-gradient(180deg, transparent, #000 20%, #000 80%, transparent);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  img {
    width: 130%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: center 46%;
    /*
     * The surplus width is 30%, so the pan can travel ±15% before an edge shows.
     * Staying inside that is what keeps the mask honest — it softens the ends, it
     * does not hide a hard edge.
     *
     * Positive sign = the ribbon travels LEFT to RIGHT as you scroll down.
     */
    transform: translate3d(calc((var(--p, 0.5) - 0.5) * 22%), 0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    img { transform: none; }
  }
</style>
