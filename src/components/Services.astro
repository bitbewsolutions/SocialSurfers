---
import { services } from '../data/services';
---

<section class="services" id="services">
  {/* the dawn ramp lives in Stats now — this section starts on plain foam */}
  <div class="shell head">
    <p class="label" data-reveal>What we do</p>
    <h2 class="h2" data-reveal>Seven services.<br />Pick one, or take them all.</h2>
    <p class="lead" data-reveal>
      Everything we offer, and exactly what&rsquo;s included in each. Click any service to
      see the full detail.
    </p>
  </div>

  <div class="shell">
    {/* a set, not a sequence — so no 01/02/03 markers. The "how we work" section is
        the thing that's actually ordered. */}
    <ul class="lines">
      {services.map((s) => (
        <li class="line" data-reveal data-reveal-group="svc">
          <a href={`/services/${s.slug}`}>
            <span class="node" aria-hidden="true"></span>
            <span class="rule" aria-hidden="true"></span>

            <span class="main">
              <h3>{s.name}</h3>
              <p>{s.blurb}</p>
            </span>

            <span class="spec">
              {s.items.slice(0, 6).map((it) => (
                <span class="chip">{it}</span>
              ))}
              {s.items.length > 6 && <span class="chip more">+{s.items.length - 6} more</span>}
            </span>

            <span class="go" aria-hidden="true">
              <svg width="15" height="10" viewBox="0 0 15 10" fill="none">
                <path d="M0 5h13M9 1l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    position: relative;
    background: var(--paper);
    color: var(--l1);
    padding-bottom: var(--section-y);
  }

  .head {
    padding-top: clamp(48px, 8vh, 96px);
    display: grid;
    gap: 20px;
  }
  .head .label { color: var(--l3); }
  .head .h2 { color: var(--l1); max-width: 20ch; }
  .head .lead { color: var(--l2); }

  /* the measured axis: a fine rule with a node per line, like a chart's y-axis.
     Keeps the instrument idea without drawing a literal surfboard. */
  .lines {
    margin-top: clamp(44px, 7vh, 84px);
    position: relative;
    padding-left: clamp(22px, 3vw, 42px);
    border-left: 1px solid var(--hair);
  }

  .line + .line { border-top: 1px solid var(--hair); }

  .line a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr) 28px;
    align-items: start;
    gap: clamp(18px, 3vw, 52px);
    padding-block: clamp(22px, 2.6vh, 34px);
    position: relative;
  }

  .node {
    position: absolute;
    left: calc(clamp(22px, 3vw, 42px) * -1 - 5px);
    top: calc(clamp(22px, 2.6vh, 34px) + 7px);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--violet);
    transition: background var(--dur-fast), border-color var(--dur-fast), transform var(--dur) var(--ease-out);
  }

  /* the annotation leader, drawn from the axis to the title on reveal */
  .rule {
    position: absolute;
    left: calc(clamp(22px, 3vw, 42px) * -1);
    top: calc(clamp(22px, 2.6vh, 34px) + 11px);
    width: clamp(22px, 3vw, 42px);
    height: 1px;
    background: linear-gradient(90deg, var(--violet), rgba(74, 27, 114, 0.12));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.65s var(--ease-tide) 0.12s;
  }
  .line.is-in .rule { transform: scaleX(1); }
  :global(html:not(.js-motion)) .rule { transform: scaleX(1); }

  .line h3 {
    font-family: var(--display);
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.022em;
    color: var(--l1);
    transition: color var(--dur-fast);
  }
  .line .main p {
    margin-top: 9px;
    font-size: 0.96rem;
    line-height: 1.55;
    color: var(--l2);
    max-width: 40ch;
  }

  /* the actual deliverables, not a vague promise — this is the spec-sheet part */
  .spec {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 4px;
  }
  .chip {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--l2);
    border: 1px solid var(--hair-2);
    border-radius: 999px;
    padding: 5px 10px;
    white-space: nowrap;
    transition: border-color var(--dur-fast), color var(--dur-fast);
  }
  .chip.more { color: var(--violet); border-color: rgba(74, 27, 114, 0.4); font-weight: 700; }

  .go {
    justify-self: end;
    align-self: center;
    color: var(--violet);
    opacity: 0.55;
    transition: transform var(--dur) var(--ease-out), opacity var(--dur-fast);
  }

  .line a:hover h3 { color: var(--violet); }
  .line a:hover .node { background: var(--rose); border-color: var(--rose); transform: scale(1.25); }
  .line a:hover .go { transform: translateX(5px); opacity: 1; }
  .line a:hover .chip { border-color: rgba(74, 27, 114, 0.34); color: var(--l1); }

  @media (max-width: 900px) {
    .line a { grid-template-columns: minmax(0, 1fr) 22px; gap: 14px; }
    .spec { display: none; } /* the count lives on the service page on small screens */
    .go { align-self: start; margin-top: 4px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rule { transform: scaleX(1); transition: none; }
  }
</style>
