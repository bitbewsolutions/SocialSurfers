---
import { services } from '../data/services';
import { waLink } from '../data/site';

/*
 * Gradient cards, per the client — but one gradient, not seven.
 *
 * Each card is a slice of the SAME violet→rose ramp, stepped by its position in the
 * set, so reading across the grid walks the brand ramp from one end to the other.
 * Seven independently-gradient boxes would have been seven competing objects; this
 * is one wave with seven windows onto it.
 *
 * The slice is computed here rather than in CSS because the alternative — mapping
 * each card's background onto its grid cell with background-size/position — has to
 * be redeclared at every breakpoint, since the column count changes underneath it.
 * An index-derived mix does not care how the cards happen to wrap.
 *
 * Both ends of the mix stay dark enough to carry white type: the ramp stops at
 * --rose and never reaches --brand-pink, on which white measures about 2.6:1. That
 * is the same cap --grad has, for the same reason.
 */
/*
 * Two numbers, and they trade against each other because both are spending the same
 * 0–100% of one ramp:
 *
 *   SPREAD  how far along the ramp the LAST card starts — the travel across the set
 *   WIDTH   each card's OWN sweep — what stops a card being a flat fill
 *
 * At 7 cards, 74/26 worked. At 16 it did not: the step between neighbours fell to
 * ~5% of the ramp, and a 26% sweep across a card is about (63,42,134) → (98,38,128),
 * which reads as solid at the ends where the ramp changes least. The fix is not to
 * rebalance the two — their sum is capped at 100 — but to make the ramp itself
 * longer, so both can be generous in actual colour.
 *
 * Hence --card-lo below: a deeper indigo than --violet. The high end stays --rose and
 * must: the next stop up is --brand-pink, on which white measures ~2.6:1, and these
 * cards carry white headings and 10.5px chips.
 */
const SPREAD = 55;
const WIDTH = 45;

const cards = services.map((s, i) => {
  const t = services.length > 1 ? i / (services.length - 1) : 0;
  const a = Math.round(t * SPREAD);
  return { ...s, a, b: a + WIDTH };
});
---

<section class="services to-dark" id="services" data-progress data-progress-anchor="0.85">
  {/* the dawn ramp lives in Stats now — this section starts on plain foam */}
  <div class="shell head">
    <p class="label" data-reveal>What we do</p>
    {/* "Seven services" was a headline and a claim at once. The figures above now
        say 14, so the number came out of the heading rather than being contradicted
        by a tile two screens up. */}
    <h2 class="h2" data-reveal>Our services.<br />Pick one, or <em>take them all.</em></h2>
    <p class="lead" data-reveal>
      Everything we offer, and exactly what&rsquo;s included in each. Open any service to
      see the full detail.
    </p>
  </div>

  <div class="shell">
    <ul class="grid">
      {cards.map((s) => (
        <li class="cell" data-reveal data-reveal-group="svc" style={`--a:${s.a}%;--b:${s.b}%`}>
          <a class="card" href={`/services/${s.slug}`}>
            <span class="sheen" aria-hidden="true"></span>

            <h3>{s.name}</h3>
            <p class="blurb">{s.blurb}</p>

            <span class="spec">
              {s.items.slice(0, 4).map((it) => (
                <span class="chip">{it}</span>
              ))}
              {s.items.length > 4 && <span class="chip more">+{s.items.length - 4} more</span>}
            </span>

            <span class="go">
              <i>See the detail</i>
              <svg width="15" height="10" viewBox="0 0 15 10" fill="none" aria-hidden="true">
                <path d="M0 5h13M9 1l4 4-4 4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        </li>
      ))}

      {/* The eighth tile. Seven cards leave a hole in the last row, and the honest
          thing to put in it is the next step rather than a filler service. */}
      <li class="cell ask" data-reveal data-reveal-group="svc">
        <div class="card">
          <h3>Not sure which one?</h3>
          <p class="blurb">
            Most brands start with management and content, then add ads once the feed is
            working. Tell us where you are and we&rsquo;ll say what we&rsquo;d do first.
          </p>
          <span class="asks">
            <a class="btn" href="#enquire">Book a discovery call</a>
            <a class="btn-ghost" href={waLink()} target="_blank" rel="noopener">WhatsApp us</a>
          </span>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .services {
    position: relative;
    background-color: var(--paper);
    color: var(--l1);
  }

  .head {
    padding-top: clamp(48px, 8vh, 96px);
    display: grid;
    gap: 20px;
  }
  .head .label { color: var(--l3); }
  .head .h2 { color: var(--l1); max-width: 20ch; }
  .head .lead { color: var(--l2); max-width: 52ch; }

  /* Six tracks so the last row splits in half without a special case: a service card
     spans two (three per row), and the closing pair spans three each. */
  .grid {
    margin-top: clamp(40px, 6vh, 76px);
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(14px, 1.6vw, 22px);
    /* The low anchor of the card ramp — deeper than --violet so the ramp is long
       enough for sixteen cards to differ visibly. Declared once here rather than per
       card, and the only place to change the set's character. */
    --card-lo: #241663;
  }
  .cell { grid-column: span 2; }
  .cell:nth-last-child(2) { grid-column: span 3; }
  .cell.ask { grid-column: span 3; }

  .card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: 100%;
    display: grid;
    align-content: start;
    gap: 12px;
    padding: clamp(22px, 2.4vw, 30px);
    border-radius: calc(var(--radius) + 6px);
    color: #fff;
    /* This card's slice of the one ramp. --p is the section's scroll progress, so
       the whole set slides along the ramp as the section passes — the wave moves.
       min() keeps the shifted stop inside the range color-mix accepts. */
    background-image: linear-gradient(
      142deg,
      color-mix(in oklab, var(--card-lo), var(--rose) min(100%, calc(var(--a) + var(--p, 0) * 10%))),
      color-mix(in oklab, var(--card-lo), var(--rose) min(100%, calc(var(--b) + var(--p, 0) * 10%)))
    );
    box-shadow: 0 18px 40px -26px rgba(30, 12, 60, 0.75);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur);
  }

  /* a soft highlight, so a flat fill reads as a surface catching light */
  .sheen {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(120% 76% at 12% 0%, rgba(255, 255, 255, 0.2), transparent 62%);
  }

  .card h3 {
    font-family: var(--display);
    font-size: var(--fs-h3);
    font-weight: var(--w-display);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .blurb {
    font-size: var(--fs-body);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.87);
  }

  .spec {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 4px;
  }
  .chip {
    font-family: var(--label);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.93);
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 999px;
    padding: 5px 10px;
    white-space: nowrap;
  }
  /* Darkens rather than lightens. Lightening the fill raised the local background
     under 10.5px text and took it to 4.24:1 against a 4.5 floor — the one place on
     the page where the count chip fell below its own siblings, which carry no fill
     at all. Going the other way puts it above them instead. */
  .chip.more {
    background: rgba(20, 8, 40, 0.22);
    border-color: rgba(255, 255, 255, 0.42);
    color: #fff;
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 6px;
    align-self: end;
  }
  .go i {
    font-style: normal;
    font-family: var(--label);
    font-size: var(--fs-label);
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .go svg { transition: transform var(--dur) var(--ease-out); }

  .card:hover { transform: translateY(-4px); box-shadow: 0 26px 54px -26px rgba(30, 12, 60, 0.9); }
  .card:hover .go svg { transform: translateX(5px); }

  /* The closing tile is the one card that is not a gradient — it is the exit from
     the set, and dressing it as another service would bury the CTA among them. */
  .ask .card {
    background-image: none;
    background-color: var(--paper-2);
    color: var(--l1);
    border: 1px solid var(--hair);
    box-shadow: 0 18px 40px -30px rgba(30, 12, 60, 0.5);
  }
  .ask .card:hover { transform: none; }
  .ask .blurb { color: var(--l2); }
  .asks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }

  @media (max-width: 1020px) {
    /* two per row: every card spans three, the closing pair included */
    .cell,
    .cell:nth-last-child(2),
    .cell.ask { grid-column: span 3; }
  }
  @media (max-width: 680px) {
    .cell,
    .cell:nth-last-child(2),
    .cell.ask { grid-column: span 6; }
  }
</style>
