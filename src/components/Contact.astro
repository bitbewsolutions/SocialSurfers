---
import Socials from './Socials.astro';
import { site, waLink, telLink, mailLink } from '../data/site';

/* Was a standalone /contact page. It is now the last band of the one-pager, at the
   client's request — the four ways to reach a human, immediately above the footer.
   The route still exists as a redirect so any link already in the wild lands in the
   right place.

   It used to sit ABOVE the enquiry form and render it as a child. Both are sections
   of the page now and index.astro orders them, which is why this file no longer
   imports Closing: a component that renders the section after it cannot be moved
   independently of it, and that is exactly what this pass had to do.

   The address is deliberately plain text, not a map link. Nobody is being invited to
   the office — the work is delivered remotely. It's here as a trust signal and for
   the Google Business Profile, and a "get directions" affordance would only suggest
   a visit that isn't on offer. */
---

<section class="ways to-dark" id="contact">
  {/* The light valley between the dark chapter above and the dark footer below was
      the longest stretch of plain paper left on the page, which is what the client
      was pointing at. Same masked wash as the About section: zero at both edges, so
      the ramps that straddle those boundaries still meet flat paper. */}
  <div class="wash" aria-hidden="true"></div>
  <div class="shell">
    {/* Deliberately headline-free. This is the utility band — the four ways to reach
        a human. The section's actual headline lives on the form below it; two big
        contact headings stacked read as the same pitch made twice. */}
    <div class="top">
      <p class="label" data-reveal>Get in touch</p>
      <p class="reach" data-reveal>{site.reachLine}</p>
    </div>

    <ul class="grid">
      <li data-reveal data-reveal-group="way">
        <span class="k">WhatsApp</span>
        <a class="v" href={waLink()} target="_blank" rel="noopener">{site.phoneDisplay}</a>
        <span class="note">Fastest reply &mdash; usually same day</span>
      </li>
      <li data-reveal data-reveal-group="way">
        <span class="k">Phone</span>
        <a class="v" href={telLink}>{site.phoneDisplay}</a>
        <span class="note">{site.timezoneNote}</span>
      </li>
      <li data-reveal data-reveal-group="way">
        <span class="k">Email</span>
        <a class="v mail" href={mailLink}>{site.email}</a>
        <span class="note">For briefs and documents</span>
      </li>
      <li data-reveal data-reveal-group="way">
        <span class="k">Where we are</span>
        {/* Two states, no street — the client's instruction. The registered address
            still goes to Google through the JSON-LD in Base.astro. */}
        <address class="v addr">{site.locations.join(' · ')}</address>
        <span class="note">Working with brands anywhere</span>
      </li>
    </ul>

    <div class="social" data-reveal>
      <span class="k">Follow us</span>
      <Socials tone="light" />
    </div>
  </div>
</section>

<style>
  /* .to-dark is the top half of the handover into the footer — it used to be on the
     enquiry section, which now sits above this one. Both of the class's paddings are
     restated because a scoped selector outranks it: it carries an attribute
     selector, .to-dark does not, so whatever this rule sets simply wins. Losing the
     bottom one silently would put the heading inside the steep part of the ramp. */
  .ways {
    position: relative;
    isolation: isolate;
    background-color: var(--paper);
    padding-top: clamp(48px, 7vh, 90px);
    padding-bottom: calc(var(--fade-h) * 0.5);
  }

  .wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(50% 46% at 16% 34%, rgba(63, 42, 134, 0.15), transparent 72%),
      radial-gradient(46% 44% at 86% 72%, rgba(234, 28, 130, 0.13), transparent 72%);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 80%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 80%, transparent);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 40px;
    margin-bottom: clamp(20px, 3vh, 30px);
  }
  .reach {
    font-family: var(--label);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--l3);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1px;
    background: var(--hair);
    border-block: 1px solid var(--hair);
  }
  .grid li { background: var(--paper); padding: 24px 22px; display: grid; gap: 8px; align-content: start; }
  .k {
    font-family: var(--label);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--l3);
  }
  .v {
    font-family: var(--display);
    font-size: 1.22rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    transition: color var(--dur-fast);
  }
  a.v:hover { color: var(--violet); }
  .v.mail, .v.addr { font-size: 1rem; word-break: break-word; }
  address.v { font-style: normal; }
  .note { font-size: 0.84rem; color: var(--l3); }

  .social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    padding-top: clamp(26px, 4vh, 40px);
  }
</style>
