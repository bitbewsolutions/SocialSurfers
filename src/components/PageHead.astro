---
/** Compact inner-page hero. Deliberately quieter than the homepage hero —
    the swell line is the homepage's showpiece and shouldn't be re-spent here. */
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  crumbs?: { name: string; url: string }[];
}
const { eyebrow, title, intro, crumbs } = Astro.props;
---

<header class="ph">
  <div class="glowline" aria-hidden="true"></div>
  <div class="shell">
    {crumbs && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c, i) => (
            <li>
              {i < crumbs.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <p class="label">{eyebrow}</p>
    <h1>{title}</h1>
    {intro && <p class="lead">{intro}</p>}
  </div>
</header>

<style>
  .ph {
    position: relative;
    padding: clamp(128px, 18vh, 190px) 0 clamp(48px, 8vh, 90px);
    background: var(--paper);
    overflow: hidden;
  }
  /* a single calm swell, echoing the homepage without repeating the whole instrument */
  .glowline {
    position: absolute;
    left: -5%;
    right: -5%;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--violet) 22%, var(--rose) 55%, transparent 92%);
    opacity: .5;
  }
  .crumbs { margin-bottom: 22px; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .crumbs li { display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--l3); }
  .crumbs li + li::before { content: '/'; color: var(--hair-2); }
  .crumbs a { color: var(--l2); }
  .crumbs a:hover { color: var(--rose); }
  .label { color: var(--l3); }
  h1 {
    margin-top: 14px;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.1rem, 5.6vw, 4.2rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    max-width: 19ch;
    text-wrap: balance;
  }
  .lead { margin-top: 20px; }
</style>
