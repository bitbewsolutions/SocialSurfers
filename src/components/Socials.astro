---
import { site } from '../data/site';

/**
 * Social channels as icons.
 *
 * Paths are inlined rather than pulled from an icon package — six glyphs is about
 * 1.4 KB of markup, where the smallest icon library would cost a runtime import
 * and a font or sprite request. Each link keeps a real accessible name via
 * aria-label, since an icon alone is not a link text.
 */
interface Props {
  /** 'dark' = light icons on the ink footer, 'light' = ink icons on foam. */
  tone?: 'dark' | 'light';
  size?: number;
}
const { tone = 'dark', size = 17 } = Astro.props;

const paths: Record<string, string> = {
