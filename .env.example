# Copy to .env for local work; set the same keys in Netlify under
# Site configuration → Environment variables. .env is gitignored.
#
# Only PUBLIC_* reaches the browser. Everything else is read by
# netlify/functions/enquiry.mjs and never leaves the server — which is the whole
# reason that function exists. Do not rename one of these to PUBLIC_.

# ── the switch ────────────────────────────────────────────────────────────────
# Unset (or empty) and the enquiry form falls back to opening the visitor's mail
# client with the fields prefilled. Set it and the form posts to the function.
# Leave it unset until at least one destination below is configured.
PUBLIC_FORM_ENDPOINT=/api/enquiry

# ── leads sheet (Google Apps Script) ──────────────────────────────────────────
# The /exec URL from Deploy → New deployment → Web app. See netlify/sheet.gs for
# the script and the full setup, including why "Anyone" access is required.
SHEET_WEBHOOK_URL=
# Any long random string. Must match TOKEN in the Apps Script exactly — it is
# what makes the URL above useless to anyone who finds it.
SHEET_WEBHOOK_TOKEN=

# ── notification email (Resend) ───────────────────────────────────────────────
# Optional. Without it the enquiry is still written to the sheet.
RESEND_API_KEY=
# Must be on a domain verified in Resend. An unverified sender is the one way
# this fails silently in production and works in every test you run first.
NOTIFY_FROM=Social Surfers <enquiries@socialsurfers.in>
NOTIFY_TO=socialsurfersmedia@gmail.com
